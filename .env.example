# --- MAX (личный аккаунт) ---
MAX_PHONE=+79990000000
# ID чата MAX: узнать командой  docker compose run --rm max2tg list-chats
MAX_CHAT_ID=
# Пароль 2FA. Можно не указывать — тогда login спросит его в консоли (надёжнее).
MAX_2FA_PASSWORD=

# --- Telegram ---
TG_BOT_TOKEN=123456:ABC...
# ID группы, начинается с -100
TG_CHAT_ID=-100xxxxxxxxxx
# ID темы. Пусто или 1 — тема «General»
TG_THREAD_ID=

# --- История ---
# С чего начать при ПЕРВОМ запуске (пока в data/state.json ещё пусто):
#   now               — только новые сообщения
#   all               — вся история чата
#   last:100          — последние 100 сообщений
#   2026-11-01        — с даты (время контейнера, TZ)
#   2026-11-01 14:30  — с даты и времени
START_FROM=last:100
# После простоя или переподключения дослать пропущенное
CATCH_UP=true
# Пауза между отправками в Telegram, сек. Лимит Telegram — около 20 сообщений в минуту на группу
TG_MIN_INTERVAL=3

# --- Поведение ---
# Пересылать и свои сообщения из MAX
FORWARD_OWN=true
# Присылать уведомление при редактировании сообщения
FORWARD_EDITS=false
# Лимит Bot API на загрузку — 50 МБ
TG_MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
